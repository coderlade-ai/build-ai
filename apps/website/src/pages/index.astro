---
import Base from "../layouts/Base.astro";
import { builderPath } from "@ladestack/i18n";
---

<Base
  title="LadeStack Build"
  description="A free, local-first, bring-your-own-key AI website and app builder. In development."
>
  <main>
    <p class="kicker">In development</p>
    <h1>LadeStack Build</h1>
    <p class="lead">
      Describe it. Build it with an agent. See and edit the code. Keep the files. This page is a
      placeholder while the website and builder are being built.
    </p>
    <a class="cta" href={builderPath("en")}>Start Building</a>
  </main>
</Base>

<style>
  main {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--section-rhythm) 24px;
  }
  .kicker {
    color: var(--color-muted);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    font-weight: 400;
    font-size: clamp(32px, 6vw, 72px);
    letter-spacing: -0.03em;
    margin: 8px 0 16px;
  }
  .lead {
    color: var(--color-body);
    font-size: 18px;
    max-width: 640px;
    line-height: 1.5;
  }
  .cta {
    display: inline-block;
    margin-top: 24px;
    background: var(--color-primary);
    color: var(--color-on-primary);
    padding: 10px 16px;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 500;
  }
  .cta:hover {
    background: var(--color-primary-active);
  }
</style>
