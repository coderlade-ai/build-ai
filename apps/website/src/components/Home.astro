---
import { builderPath, type Locale } from "@ladestack/i18n";
import Base from "../layouts/Base.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import { t } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const app = builderPath(locale);
---

<Base title={d.meta.title} description={d.meta.description} locale={locale}>
  <SiteHeader locale={locale} path="/" />

  <main id="main">
    <p class="status wrap" role="note">{d.status}</p>

    <section class="hero wrap">
      <p class="eyebrow">{d.hero.eyebrow}</p>
      <h1>{d.hero.title}</h1>
      <p class="lead">{d.hero.subtitle}</p>
      <div class="cta-row">
        <a class="btn" href={app}>{d.hero.primary}</a>
        <a class="btn-ghost" href="#how-it-works">{d.hero.secondary}</a>
      </div>
    </section>

    <section id="features" class="wrap section" aria-labelledby="features-h">
      <h2 id="features-h">{d.features.title}</h2>
      <p class="intro">{d.features.intro}</p>
      <ul class="grid">
        {
          d.features.items.map((i) => (
            <li class="card">
              <h3>{i.title}</h3>
              <p>{i.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="use-cases" class="wrap section" aria-labelledby="use-cases-h">
      <h2 id="use-cases-h">{d.useCases.title}</h2>
      <p class="intro">{d.useCases.intro}</p>
      <ul class="grid">
        {
          d.useCases.items.map((i) => (
            <li class="card">
              <h3>{i.title}</h3>
              <p>{i.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="how-it-works" class="wrap section" aria-labelledby="how-h">
      <h2 id="how-h">{d.howItWorks.title}</h2>
      <ol class="steps">
        {
          d.howItWorks.steps.map((s, n) => (
            <li>
              <span class="num" aria-hidden="true">
                {String(n + 1).padStart(2, "0")}
              </span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="technology" class="wrap section" aria-labelledby="tech-h">
      <h2 id="tech-h">{d.technology.title}</h2>
      <p class="intro">{d.technology.intro}</p>
      <ul class="grid two">
        {
          d.technology.items.map((i) => (
            <li class="card">
              <h3>{i.title}</h3>
              <p>{i.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap section" aria-labelledby="byok-h">
      <h2 id="byok-h">{d.byok.title}</h2>
      <ul class="grid">
        {
          d.byok.items.map((i) => (
            <li class="card">
              <h3>{i.title}</h3>
              <p>{i.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap section" aria-labelledby="faq-h">
      <h2 id="faq-h">{d.faq.title}</h2>
      <div class="faq">
        {
          d.faq.items.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="wrap section final" aria-labelledby="cta-h">
      <h2 id="cta-h">{d.cta.title}</h2>
      <p>{d.cta.body}</p>
      <a class="btn" href={app}>{d.cta.button}</a>
    </section>
  </main>

  <SiteFooter locale={locale} path="/" />
</Base>

<style>
  .status {
    margin-top: 24px;
    margin-bottom: 0;
    font-size: 14px;
    color: var(--color-body);
  }
  .hero {
    padding-block: 56px var(--section-rhythm);
  }
  .eyebrow {
    color: var(--color-muted);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
  }
  h1 {
    font-weight: 400;
    font-size: clamp(32px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 12px 0 20px;
    max-width: 14ch;
  }
  .lead {
    color: var(--color-body);
    font-size: 18px;
    max-width: 640px;
    margin: 0;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .section {
    padding-block: var(--section-rhythm);
    border-top: 1px solid var(--color-hairline);
    scroll-margin-top: 72px;
  }
  .intro {
    color: var(--color-body);
    margin: 0 0 32px;
    max-width: 640px;
  }
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .grid.two {
    grid-template-columns: repeat(2, 1fr);
  }
  .card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    padding: 24px;
  }
  .card h3,
  .steps h3 {
    font-size: 17px;
    font-weight: 500;
    margin: 0 0 6px;
  }
  .card p,
  .steps p {
    margin: 0;
    color: var(--color-body);
    font-size: 15px;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }
  .num {
    font-family: var(--font-mono);
    color: var(--color-primary);
    font-size: 13px;
  }
  .faq {
    max-width: 760px;
    margin-top: 24px;
  }
  .faq details {
    border-bottom: 1px solid var(--color-hairline);
    padding: 16px 0;
  }
  .faq summary {
    font-weight: 500;
    cursor: pointer;
  }
  .faq p {
    color: var(--color-body);
    margin: 10px 0 0;
  }
  .final {
    text-align: center;
  }
  .final p {
    color: var(--color-body);
    margin: 0 0 24px;
  }
  @media (max-width: 960px) {
    .grid,
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .grid,
    .grid.two,
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
